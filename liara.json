{
  "port": 8080,
  "build": {
    "location": "germany"
  },
    "healthCheck": {
    "command": ["curl", "--fail", "http://127.0.0.1:8080/"],
    "interval": 10000,
    "timeout": 5000,
    "retries": 10,
    "startPeriod": 3000
    },
  "disks": [
    {
      "name": "truthline-db",
      "mountTo": "/app/web_app/data/db"
    }
  ]
}