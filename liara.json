{
  "port": 8080,
  "build": {
    "location": "germany"
  },
  "healthCheck": {
    "command": "CMD curl --fail http://localhost:8080 || exit 1",
    "interval": 30000,
    "timeout": 10000,
    "retries": 3,
    "startPeriod": 5000
  },
  "disks": [
    {
      "name": "truthline-db",
      "mountTo": "/app/web_app/data/db"
    }
  ]
}